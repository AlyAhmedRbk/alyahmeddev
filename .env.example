# Public site origin used for canonical URLs, sitemap, and Open Graph.
# Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Sends contact-form messages through Resend.
# Leave unset to keep the form in validation-only mode. The site then
# shows the public email address instead of pretending a message was sent.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=alyahmedrbk@gmail.com

# Optional. Raises GitHub API rate limits for the public profile snapshot.
# The site falls back to checked-in data when this is empty or the API fails.
GITHUB_TOKEN=
